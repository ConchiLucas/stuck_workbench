      "source": {
        "id": "shape-sort",
        "groupId": "shape",
        "title": "图形分类",
        "moduleTitle": "认识图形",
        "learningGoal": "发现图形之间的共同特征，并按照明确规则进行分类。",
        "rules": [
          "先观察所有图形的特点",
          "确定这次分类使用的规则",
          "把每个图形放进对应小组"
        ],
        "revision": 2,
        "publishedRevision": 2,
        "example": {
          "kind": "shape-sort",
          "prompt": "按“有没有角”分成两组",
          "buckets": [
            {
              "label": "没有角",
              "items": [
                "○",
                "◯"
              ]
            },
            {
              "label": "有角",
              "items": [
                "△",
                "□",
                "◇"
